{
  "name": "openscad-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://ochafik.com/openscad2/",
  "dependencies": {
    "@bitbybit-dev/occt": "^1.0.2",
    "@firstform/json-url": "^4.1.0",
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@monaco-editor/loader": "^1.4.0",
    "@monaco-editor/react": "^4.6.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "assert": "^2.1.0",
    "blurhash": "^2.0.5",
    "chroma-js": "^3.1.2",
    "debug": "^4.4.0",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2",
    "occt-wasm": "^3.3.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.166.1",
    "thumbhash": "^0.1.1",
    "util": "^0.12.5",
    "uuid": "^11.0.3",
    "uzip": "^0.20201231.0"
  },
  "scripts": {
    "test:e2e": "jest",
    "models:index": "node scripts/generate-models-index.mjs",
    "models:check": "node scripts/generate-models-index.mjs --check",
    "models:fix": "node scripts/generate-models-index.mjs --fix",
    "models:validate:occt": "node scripts/validate-occt-model.mjs",
    "prestart:development": "npm run models:index && npm run occt:fetch",
    "start:development": "vite --mode development",
    "start:production": "NODE_ENV=production PUBLIC_URL=http://localhost:3000/dist/ npm run build && npx serve .",
    "start:test": "vite --mode development --host 0.0.0.0",
    "serve:test:production": "npx serve . -l 0.0.0.0:3000",
    "start": "npm run start:development",
    "prebuild": "npm run models:index && npm run occt:fetch",
    "build": "vite build",
    "occt:fetch": "node scripts/fetch-occt-versions.mjs",
    "build:libs": "LIBS_BUILD_MODE=all node scripts/build-libs.mjs",
    "build:libs:clean": "LIBS_BUILD_MODE=clean node scripts/build-libs.mjs",
    "build:libs:wasm": "LIBS_BUILD_MODE=wasm node scripts/build-libs.mjs",
    "build:libs:fonts": "LIBS_BUILD_MODE=fonts node scripts/build-libs.mjs",
    "build:all": "npm run build:libs && npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^2.4.5",
    "@types/debug": "^4.1.12",
    "@types/filesystem": "^0.0.36",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uzip": "^0.20201231.2",
    "@types/web": "^0.0.140",
    "@vitejs/plugin-react": "^6.0.2",
    "jest": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "puppeteer": "^25.0.2",
    "serve": "^14.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
